<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives beside this project, keep its files out of the web app's default globs. -->
    <Compile Remove="FirstApplication.Tests\**" />
    <Content Remove="FirstApplication.Tests\**" />
    <EmbeddedResource Remove="FirstApplication.Tests\**" />
    <None Remove="FirstApplication.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="11.0.0" />
  </ItemGroup>

</Project>
